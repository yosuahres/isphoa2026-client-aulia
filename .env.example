APP_NAME="ISPhOA 2026"
# Production-shaped on purpose: a careless copy of this file should fail
# closed, not serve Ignition stack traces to the internet. For local work set
# APP_ENV=local, APP_DEBUG=true, and drop SESSION_SECURE_COOKIE.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Canonical origin. Every canonical, og:url and sitemap <loc> is built from
# this, so production MUST set it to the real https:// domain. If it is left
# as localhost, App\Support\Seo falls back to the seminar's own domain
# rather than advertising localhost to crawlers.
APP_URL=https://isphoa2026.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# cPanel's MySQL. Create the database and user under MySQL(R) Databases, then
# grant the user ALL PRIVILEGES on it -- a new user has none by default and
# migrate will fail with "access denied" until you do.
#
# cPanel prefixes both names with your account, so what you type as "isphoa"
# is really "youracct_isphoa". Copy the full prefixed names from the panel
# rather than typing them here.
#
# DB_HOST stays localhost: the database runs on the same machine as PHP, and
# cPanel does not expose MySQL externally unless you add your IP under Remote
# MySQL(R).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=youracct_isphoa
DB_USERNAME=youracct_isphoa
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# At rest the session payload is readable by anything that can read the
# sessions table or the filesystem; encrypting costs one setting.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Refuses to send the session cookie over plain http, so it cannot be
# captured by a network observer during a downgrade.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync, not database. A database queue needs `php artisan queue:work` running
# continuously, which shared cPanel hosting cannot hold open. With no worker,
# queued jobs sit in the table forever and password-reset and team-invitation
# mail silently never arrives. sync runs them inline: slower requests, but
# nothing is lost. Switch to database only once a worker is genuinely running.
QUEUE_CONNECTION=sync

# file avoids a database round trip per cache read and needs no extra table
# maintenance; on a site this size the difference is not measurable either way.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated proxy IPs, or "*" for whatever fronts the app. cPanel
# terminates TLS upstream, so without this the app sees a plain http request:
# HSTS and upgrade-insecure-requests are then suppressed on a site that really
# is served over TLS. See config/security.php.
TRUSTED_PROXIES=
